# Copy to .env.local for local dev. Real values never go in the repo.
# On Vercel: Project → Settings → Environment Variables (all environments).

# Postgres for drizzle. Locally: `pnpm db:up` starts docker-compose's postgres 16
# and this URL points at it. On Vercel: the provisioned Postgres connection
# string (transaction pooler if it's Supabase; `prepare: false` is already set).
# If unset, the app renders an honest "database not configured" state and
# /api/health reports it — pages never 500 because of it.
# A platform integration may prefix these names (<prefix>_DATABASE_URL,
# <prefix>_POSTGRES_URL, …); the app accepts DATABASE_URL, <prefix>_DATABASE_URL,
# POSTGRES_URL, <prefix>_POSTGRES_URL in that order; the server log says which
# name it used when the database check fails.
# For remote migrate/seed, put DATABASE_URL in a gitignored .env.remote.local
# and run pnpm db:migrate:remote / pnpm db:seed:remote.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/amplio

# LLM provider, resolved once at startup: ANTHROPIC_API_KEY → GEMINI_API_KEY →
# template; every call falls through to the next provider on a billing / auth /
# quota error (400 credit balance, 401, 403, 429) or a network failure, and that
# provider is set aside for 10 minutes (logged by /api/health), so a topped-up
# account comes back without a redeploy. Health reports the provider that
# actually answered a probe (ai). Used by the AI brief, the onboarding value prop + ICPs, the matching
# rationale and the voice intent route; without a key all four fall back to
# templates and the UI says so. /api/health reports which one is in use (ai:
# "anthropic" | "gemini" | "template"); the key-looking variable names it can
# see go to the server log, not the response. console.anthropic.com → API keys.
ANTHROPIC_API_KEY=
# Gemini via the official @google/genai SDK, model gemini-2.5-flash, structured
# JSON output validated with the same zod schemas. aistudio.google.com → API keys.
GEMINI_API_KEY=

# Resend API key for the password reset email (the only email this build sends).
# Optional: without it the reset link is shown on screen only, which happens
# anyway. Free-plan Resend only delivers to the account owner's address; other
# sends fail and are logged, the page falls back to the on-screen link.
# resend.com → API keys.
RESEND_API_KEY=

# Voice (optional). With both keys the mic on the floating pill starts a Vapi
# call (their transcription + voice; our /api/voice/vapi webhook runs the
# actions). Without them it uses the browser's Web Speech API (Chrome/Safari)
# and /api/voice/intent directly. Intent parsing uses ANTHROPIC_API_KEY when
# set, otherwise a regex grammar (src/lib/voice-grammar.ts). dashboard.vapi.ai → API keys.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
VAPI_PRIVATE_KEY=
# Optional: the shared secret Vapi sends (x-vapi-secret) on every webhook call.
# Unset, one is derived from VAPI_PRIVATE_KEY, so calls work either way.
VAPI_SERVER_SECRET=

# Set automatically by Vercel; used by /api/health to report the deployed commit.
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_DEPLOYMENT_ID=   (set by Vercel; keys the data cache per deploy, falls back to the commit sha)

# LinkedIn profile import (creator onboarding): Apify token, server-side only.
# Actor: harvestapi/linkedin-profile-scraper, build pinned in
# src/features/creator-onboarding/server/linkedin-import.ts. Unset: the import
# reports "couldn't read that profile" and the creator enters the card by hand.
APIFY_TOKEN=

# Agent mode (the agent page, its sidebar item and ⌘K, and /api/agent). Off unless "1".
# Uses GEMINI_API_KEY; with no Gemini key /api/agent answers through the existing assistant.
NEXT_PUBLIC_FF_AGENT_MODE=
# Optional: signs the agent's pending confirmations. Unset, a key is derived
# from a server-only value, so confirmations still work.
AGENT_SIGNING_SECRET=
